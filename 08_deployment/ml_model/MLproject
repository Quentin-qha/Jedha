name: car_price_prediction_per_day

docker_env:
  image: qhae/mlflow-custom
  environment:
    - MLFLOW_TRACKING_URI
    - AWS_ACCESS_KEY_ID
    - AWS_SECRET_ACCESS_KEY
    #- BACKEND_STORE_URI
    - ARTIFACT_ROOT

entry_points:
  main:
    parameters:
      n_estimators: {type: int, default: 700}
      depth: {type: int, default: 6}
      l2_leaf_reg: {type: int, default: 9}
      learning_rate: {type: float, default: 0.08}
    command: >
      python src/pipeline/train.py\
      --n_estimators {n_estimators}\
      --depth {depth}\
      --l2_leaf_reg {l2_leaf_reg}\
      --learning_rate {learning_rate}